          { name: { ru: 'Эспрессо (40 мл) / Американо (200 мл)', kg: 'Эспрессо / Американо', en: 'Espresso (40 ml) / Americano (200 ml)' }, desc: { ru: 'Классический крепкий черный кофе из свежеобжаренных зерен.', kg: 'Классикалык кара кофе.', en: 'Classic black coffee.' }, weight: '40 / 200 мл', price: 180 },
          { name: { ru: 'Кофе по-восточному (40 мл)', kg: 'Чыгыш кофеси (40 мл)', en: 'Turkish / Eastern Coffee (40 ml)' }, desc: { ru: 'Крепкий кофе мелкого помола, сваренный в турке.', kg: 'Туркада бышырылган күчтүү кофе.', en: 'Finely ground strong coffee brewed in a cezve.' }, weight: '40 мл', price: 200 },
          { name: { ru: 'Капучино (230 мл) / Флэт Уайт (210 мл)', kg: 'Капучино / Флэт Уайт', en: 'Cappuccino (230 ml) / Flat White (210 ml)' }, desc: { ru: 'Эспрессо со взбитым в пышную бархатную пену молоком.', kg: 'Эспрессо жана көбүртүлгөн сүт.', en: 'Espresso with velvety steamed milk foam.' }, weight: '210–230 мл', price: 270 },
          { name: { ru: 'Латте (250 мл) / Айс Капучино (250 мл)', kg: 'Латте / Айс Капучино', en: 'Latte / Iced Cappuccino (250 ml)' }, desc: { ru: 'Мягкий кофейный напиток с горячим молоком или охлажденный со льдом.', kg: 'Сүт кошулган жумшак кофе же муздак айс капучино.', en: 'Smooth milky coffee or chilled iced cappuccino.' }, weight: '250 мл', price: 300 },
          { name: { ru: 'Какао (250 мл) / Колд Брю (280 мл)', kg: 'Какао / Колд Брю', en: 'Cocoa (250 ml) / Cold Brew (280 ml)' }, desc: { ru: 'Нежный горячий какао с молоком или кофе холодного заваривания длительной экстракции.', kg: 'Жумшак какао же муздак сууда демделген колд брю.', en: 'Comforting cocoa with milk or slow-steeped cold brew.' }, weight: '250–280 мл', price: 350 },
          { name: { ru: 'Раф кофе (250 мл) / Раф Урбеч / Айс Урбеч (230 мл)', kg: 'Раф / Раф Урбеч / Үрбеч кошулган Айс кофе', en: 'Raf Coffee / Raf Urbech / Iced Urbech' }, desc: { ru: 'Сливочный раф с ванилью, халвой или натуральной ореховой пастой урбеч.', kg: 'Каймак, халва же үрбеч пастасы кошулган өзгөчө кофе.', en: 'Creamy raf infused with vanilla, halva, or nut paste urbech.' }, weight: '220–250 мл', price: 380, badge: 'Хит' },
          { name: { ru: 'Альтернативный кофе: Декаф / Безлактозное / Матча Латте (200 мл)', kg: 'Декаф / Лактозасыз кофе / Матча Латте', en: 'Decaf / Lactose-Free Coffee / Matcha Latte (200 ml)' }, desc: { ru: 'Кофе без кофеина, на безлактозном молоке или японский зеленый чай матча со взбитым молоком.', kg: 'Кофеинсиз, лактозасыз кофе же япон матча латте.', en: 'Decaffeinated coffee, lactose-free milk coffee, or Japanese green matcha latte.' }, weight: '200 мл', price: 380 },
          { name: { ru: 'Эспрессо Тоник (200 мл)', kg: 'Эспрессо Тоник (200 мл)', en: 'Espresso Tonic (200 ml)' }, desc: { ru: 'Освежающий микс из эспрессо, тоника и льда.', kg: 'Эспрессо, тоник жана муз аралашмасы.', en: 'Refreshing mix of espresso, tonic water, and ice.' }, weight: '200 мл', price: 390 },
          { name: { ru: 'Горячий шоколад (250 мл)', kg: 'Ысык шоколад (250 мл)', en: 'Hot Chocolate (250 ml)' }, desc: { ru: 'Густой горячий напиток из топленого шоколада.', kg: 'Коюу, каныккан ысык шоколад суусундугу.', en: 'Thick and rich warm melted chocolate drink.' }, weight: '250 мл', price: 450 },
          { name: { ru: 'Бамбл кофе (250 мл)', kg: 'Бамбл кофеси (250 мл)', en: 'Bumble Coffee (250 ml)' }, desc: { ru: 'Слоистый освежающий напиток из эспрессо, апельсинового сока и карамельного сиропа.', kg: 'Эспрессо, апельсин ширеси жана карамель сиропу бар муздак суусундук.', en: 'Layered cold drink made with espresso, orange juice, and caramel syrup.' }, weight: '250 мл', price: 470 },
          { name: { ru: 'Айс Матча-Латте (250 мл)', kg: 'Айс Матча-Латте (250 мл)', en: 'Iced Matcha Latte (250 ml)' }, desc: { ru: 'Холодный освежающий напиток из японского чая матча, молока и льда.', kg: 'Матча чайы, сүт жана муз кошулган муздак суусундук.', en: 'Chilled drink made of Japanese matcha tea, milk, and ice.' }, weight: '250 мл', price: 480 },
        ],
      },
    ];

    // =========================================================================
    // 4. ИНИЦИАЛИЗАЦИЯ СЛАЙДЕРА HERO И БЕСШОВНОЙ ГАЛЕРЕИ
    // =========================================================================
    let currentHeroSlide = 0;
    function startHeroSlideshow() {
      const slides = document.querySelectorAll('.hero-slide');
      if (!slides.length) return;
      setInterval(() => {
        slides[currentHeroSlide].classList.remove('opacity-100');
        slides[currentHeroSlide].classList.add('opacity-0');
        currentHeroSlide = (currentHeroSlide + 1) % slides.length;
        slides[currentHeroSlide].classList.remove('opacity-0');
        slides[currentHeroSlide].classList.add('opacity-100');
      }, 6500);
    }

    function renderMarqueeGallery() {
      const track = document.getElementById('marquee-cards');
      if (!track) return;
      // Дублируем массив дважды для бесконечного бесшовного движения
      const doubled = [...MOVING_PICTURES, ...MOVING_PICTURES];
      track.innerHTML = doubled
        .map(
          (pic, idx) => `
          <div class="group relative w-64 sm:w-80 h-80 sm:h-96 rounded-3xl overflow-hidden shrink-0 border border-goldAccent/30 shadow-xl bg-charcoal cursor-pointer" onclick="scrollToMenu()">
            <img
              src="${pic.img}"
              onerror="this.src='https://placehold.co/600x800/2E261F/C59638?text=KEMEGE'"
              alt="${pic.title[currentLang]}"
              class="w-full h-full object-cover ${idx % 2 === 0 ? 'animate-ken-burns' : 'animate-ken-burns-alt'} group-hover:scale-110 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-espresso via-espresso/20 to-transparent opacity-90"></div>
            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 rounded-full bg-espresso/80 backdrop-blur-md border border-goldAccent/40 text-goldAccent text-xs font-semibold">
                ${pic.tag}
              </span>
            </div>
            <div class="absolute bottom-5 left-5 right-5">
              <h3 class="font-serif font-bold text-xl sm:text-2xl text-white leading-snug group-hover:text-goldAccent transition-colors">
                ${pic.title[currentLang]}
              </h3>
            </div>
          </div>
        `
        )
        .join('');
    }

    function scrollToMenu() {
      document.getElementById('menu').scrollIntoView({ behavior: 'smooth' });
    }

    // =========================================================================
    // 5. РЕНДЕРИНГ ВКЛАДОК КАТЕГОРИЙ И ПОЛНОГО МЕНЮ
    // =========================================================================
    function renderCategoryTabs() {
      const container = document.getElementById('category-tabs');
      if (!container) return;

      const allLabel = UI_STRINGS[currentLang].allCategories;
      let html = `
        <button
          onclick="selectCategory('all')"
          class="px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all ${
            selectedCategory === 'all'
              ? 'bg-espresso text-goldAccent shadow-md'
              : 'bg-creamSurface text-stone-700 hover:bg-stone-200 border border-stone-300'
          }"
        >
          ✨ ${allLabel}
        </button>
      `;

      MENU_CATEGORIES.forEach((cat) => {
        const isActive = selectedCategory === cat.id;
        html += `
          <button
            onclick="selectCategory('${cat.id}')"
            class="px-4 py-2 rounded-full text-xs sm:text-sm font-semibold whitespace-nowrap transition-all ${
              isActive
                ? 'bg-espresso text-goldAccent shadow-md'
                : 'bg-creamSurface text-stone-700 hover:bg-stone-200 border border-stone-300'
            }"
          >
            ${cat.icon} ${cat.title[currentLang]}
          </button>
        `;
      });

      container.innerHTML = html;
    }

    function selectCategory(catId) {
      selectedCategory = catId;
      renderCategoryTabs();
      renderMenu();
    }

    function filterMenu() {
      renderMenu();
    }

    function renderMenu() {
      const container = document.getElementById('menu-container');
      const searchInput = document.getElementById('menu-search');
      const query = (searchInput ? searchInput.value : '').trim().toLowerCase();

      let html = '';

      MENU_CATEGORIES.forEach((cat) => {
        if (selectedCategory !== 'all' && selectedCategory !== cat.id) return;

        const filteredItems = cat.items.filter((item) => {
          if (!query) return true;
          const nRu = item.name.ru.toLowerCase();
          const nKg = item.name.kg.toLowerCase();
          const nEn = item.name.en.toLowerCase();
          const dCur = item.desc[currentLang].toLowerCase();
          return nRu.includes(query) || nKg.includes(query) || nEn.includes(query) || dCur.includes(query);
        });

        if (filteredItems.length === 0) return;

        html += `
          <div class="menu-section">
            <!-- Баннер категории с плавной движущейся картиной -->
            <div class="relative h-36 sm:h-44 rounded-3xl overflow-hidden mb-6 shadow-lg border border-stone-300/70 flex items-end p-6 sm:p-8 bg-espresso">
              <img
                src="${cat.cover}"
                onerror="this.src='https://placehold.co/1200x400/231C16/C59638?text=KEMEGE'"
                alt="${cat.title[currentLang]}"
                class="absolute inset-0 w-full h-full object-cover animate-ken-burns opacity-45"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-espresso/90 via-espresso/60 to-transparent"></div>
              <div class="relative z-10 flex items-center justify-between w-full">
                <div>
                  <span class="text-2xl sm:text-3xl mr-2">${cat.icon}</span>
                  <h3 class="inline font-serif font-bold text-2xl sm:text-4xl text-white align-middle">
                    ${cat.title[currentLang]}
                  </h3>
                </div>
                <span class="hidden sm:inline-block px-3.5 py-1 rounded-full bg-goldAccent/20 border border-goldAccent/40 text-goldAccent text-xs font-semibold">
                  ${filteredItems.length} поз.
                </span>
              </div>
            </div>

            <!-- Сетка карточек блюд -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              ${filteredItems
                .map((item) => {
                  const safeName = item.name[currentLang].replace(/'/g, "\\'");
                  return `
                  <div class="bg-creamSurface rounded-2xl p-5 shadow-sm hover:shadow-xl border border-stone-200/90 hover:border-goldAccent/60 transition-all duration-300 flex flex-col justify-between group">
                    <div>
                      <div class="flex items-start justify-between gap-3 mb-2">
                        <h4 class="font-serif font-bold text-xl text-espresso group-hover:text-goldDark transition-colors leading-snug">
                          ${item.name[currentLang]}
                        </h4>
                        ${
                          item.badge
                            ? `<span class="shrink-0 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300 text-[11px] font-bold">${item.badge}</span>`
                            : ''
                        }
                      </div>
                      <p class="text-xs sm:text-sm text-stone-600 leading-relaxed mb-4">
                        ${item.desc[currentLang]}
                      </p>
                    </div>

                    <div class="pt-3.5 border-t border-stone-200/80 flex items-center justify-between gap-2">
                      <div>
                        <span class="block text-[11px] text-stone-400 font-medium">${item.weight}</span>
                        <span class="font-serif font-bold text-xl text-espresso">${item.price} с</span>
                      </div>
                      <button
                        onclick="addToCart('${safeName}', ${item.price}, '${item.weight}')"
                        class="px-4 py-2 rounded-xl bg-espresso hover:bg-goldAccent text-creamSurface hover:text-espresso font-semibold text-xs transition-all active:scale-95 shadow-sm"
                      >
                        ${UI_STRINGS[currentLang].addToCart}
                      </button>
                    </div>
                  </div>
                `;
                })
                .join('')}
            </div>
          </div>
        `;
      });

      if (!html) {
        html = `
          <div class="text-center py-16 bg-creamSurface rounded-3xl border border-stone-200">
            <p class="font-serif text-2xl text-stone-600 mb-2">Ничего не найдено по вашему запросу</p>
            <button onclick="document.getElementById('menu-search').value=''; selectCategory('all');" class="mt-2 px-5 py-2.5 rounded-xl bg-espresso text-goldAccent text-sm font-semibold">
              Показать все блюда
            </button>
          </div>
        `;
      }

      container.innerHTML = html;
    }

    // =========================================================================
    // 6. ПЕРЕКЛЮЧЕНИЕ ЯЗЫКОВ (RU / KG / EN)
    // =========================================================================
    function setLanguage(lang) {
      currentLang = lang;

      // Обновляем активную кнопку
      ['ru', 'kg', 'en'].forEach((code) => {
        const btn = document.getElementById(`lang-${code}`);
        if (btn) {
          if (code === lang) {
            btn.className = 'lang-btn px-2.5 py-1 rounded-full text-xs font-semibold transition-all bg-goldAccent text-espresso';
          } else {
            btn.className = 'lang-btn px-2.5 py-1 rounded-full text-xs font-semibold transition-all text-stone-300 hover:text-white';
          }
        }
      });

      // Переводим все статические элементы с data-i18n
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (UI_STRINGS[lang] && UI_STRINGS[lang][key]) {
          el.textContent = UI_STRINGS[lang][key];
        }
      });

      const searchEl = document.getElementById('menu-search');
      if (searchEl) searchEl.placeholder = UI_STRINGS[lang].searchPlaceholder;

      renderMarqueeGallery();
      renderCategoryTabs();
      renderMenu();
    }

    // =========================================================================
    // 7. КОРЗИНА ПРЕДЗАКАЗА И ОТПРАВКА В WHATSAPP (+996503000073)
    // =========================================================================
    function showToast(message) {
      const box = document.getElementById('toast-box');
      const text = document.getElementById('toast-text');
      text.textContent = message;
      box.classList.remove('opacity-0', 'translate-y-3');
      setTimeout(() => {
        box.classList.add('opacity-0', 'translate-y-3');
      }, 2200);
    }

    function addToCart(name, price, weight) {
      const existing = cart.find((i) => i.name === name);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({ name, price, weight, qty: 1 });
      }
      updateCartUI();
      showToast(`${name} — добавлено!`);
    }

    function changeQty(index, delta) {
      cart[index].qty += delta;
      if (cart[index].qty <= 0) {
        cart.splice(index, 1);
      }
      updateCartUI();
    }

    function updateCartUI() {
      const badge = document.getElementById('cart-badge');
      const list = document.getElementById('cart-items-list');
      const totalEl = document.getElementById('cart-total-price');

      const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
      const totalSum = cart.reduce((sum, item) => sum + item.price * item.qty, 0);

      badge.textContent = totalCount;
      totalEl.textContent = `${totalSum} с`;

      if (cart.length === 0) {
        list.innerHTML = `
          <div class="text-center py-10 text-stone-500 text-sm">
            Корзина пока пуста. Выберите блюда из меню ресторана KEMEGE!
          </div>
        `;
        return;
      }

      list.innerHTML = cart
        .map(
          (item, idx) => `
          <div class="flex items-center justify-between gap-3 p-3.5 rounded-2xl bg-white border border-stone-200">
            <div class="min-w-0 flex-1">
              <div class="font-semibold text-sm text-espresso truncate">${item.name}</div>
              <div class="text-xs text-stone-500">${item.weight} • ${item.price} с</div>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="changeQty(${idx}, -1)" class="w-7 h-7 rounded-lg bg-stone-200 hover:bg-stone-300 font-bold text-sm">−</button>
              <span class="w-6 text-center text-sm font-bold">${item.qty}</span>
              <button onclick="changeQty(${idx}, 1)" class="w-7 h-7 rounded-lg bg-espresso text-goldAccent font-bold text-sm">+</button>
            </div>
          </div>
        `
        )
        .join('');
    }

    function toggleCartModal() {
      const modal = document.getElementById('cart-modal');
      if (modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        updateCartUI();
      } else {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    }

    function setOrderType(type) {
      orderType = type;
      const btnDel = document.getElementById('type-delivery');
      const btnPick = document.getElementById('type-pickup');
      if (type === 'Доставка') {
        btnDel.className = 'py-2 px-3 rounded-xl text-xs font-semibold border border-goldAccent bg-goldAccent text-espresso transition-all';
        btnPick.className = 'py-2 px-3 rounded-xl text-xs font-semibold border border-stone-300 bg-white text-stone-700 transition-all';
      } else {
        btnPick.className = 'py-2 px-3 rounded-xl text-xs font-semibold border border-goldAccent bg-goldAccent text-espresso transition-all';
        btnDel.className = 'py-2 px-3 rounded-xl text-xs font-semibold border border-stone-300 bg-white text-stone-700 transition-all';
      }
    }

    function sendOrderToWhatsApp() {
      if (cart.length === 0) {
        showToast('Сначала добавьте блюда в корзину');
        return;
      }

      const address = document.getElementById('order-address').value.trim() || 'Не указан';
      const totalSum = cart.reduce((sum, item) => sum + item.price * item.qty, 0);

      let lines = [
        `🍽️ *НОВЫЙ ЗАКАЗ — РЕСТОРАН KEMEGE*`,
        `📍 Адрес ресторана: пр. Аалы Токомбаева, 21Б/5`,
        `📦 Тип заказа: *${orderType}*`,
        `🏠 Адрес / Столик: ${address}`,
        ``,
        `*Состав заказа:*`,
      ];

      cart.forEach((item, i) => {
        lines.push(`${i + 1}. ${item.name} (${item.weight}) × ${item.qty} = ${item.price * item.qty} с`);
      });

      lines.push(``);
      lines.push(`💰 *ИТОГО: ${totalSum} сом*`);

      const encoded = encodeURIComponent(lines.join('\n'));
      window.open(`https://wa.me/996503000073?text=${encoded}`, '_blank');
    }

    function submitBookingWhatsApp(event) {
      event.preventDefault();
      const name = document.getElementById('book-name').value.trim();
      const guests = document.getElementById('book-guests').value;
      const date = document.getElementById('book-date').value;
      const time = document.getElementById('book-time').value;
      const note = document.getElementById('book-note').value.trim();

      const msg = [
        `✨ *БРОНЬ СТОЛИКА — РЕСТОРАН KEMEGE*`,
        `👤 Имя: *${name}*`,
        `👥 Гостей: *${guests}*`,
        `📅 Дата: *${date}*`,
        `⏰ Время: *${time}*`,
        note ? `📝 Пожелания: ${note}` : '',
        `📍 Адрес: пр. Аалы Токомбаева, 21Б/5, 1 этаж`,
      ]
        .filter(Boolean)
        .join('\n');

      window.open(`https://wa.me/996503000073?text=${encodeURIComponent(msg)}`, '_blank');
    }

    // =========================================================================
    // 8. ЗАПУСК ПРИ ЗАГРУЗКЕ СТРАНИЦЫ
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      // Устанавливаем сегодняшнюю дату по умолчанию в форме бронирования
      const dateInput = document.getElementById('book-date');
      if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.value = today;
      }

      startHeroSlideshow();
      renderMarqueeGallery();
      renderCategoryTabs();
      renderMenu();
      updateCartUI();

      // Анимация плавного появления секций при прокрутке
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
            }
          });
        },
        { threshold: 0.12 }
      );

      document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));
    });
  </script>
</body>
