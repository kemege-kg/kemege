  <style>
    /* Текстура натурального камня/травертина в стиле обложки KEMEGE */
    .travertine-bg {
      background-color: #F4EFE6;
      background-image:
        radial-gradient(rgba(46, 38, 31, 0.04) 1px, transparent 0),
        radial-gradient(rgba(197, 150, 56, 0.05) 1px, transparent 0);
      background-size: 28px 28px;
      background-position: 0 0, 14px 14px;
    }

    /* Эффект движущихся картин (Ken Burns Effect) */
    @keyframes kenBurnsSlow {
      0% {
        transform: scale(1) translate3d(0, 0, 0);
      }
      50% {
        transform: scale(1.12) translate3d(-1.5%, -1%, 0);
      }
      100% {
        transform: scale(1) translate3d(0, 0, 0);
      }
    }

    @keyframes kenBurnsAlt {
      0% {
        transform: scale(1.08) translate3d(1%, 0.5%, 0);
      }
      50% {
        transform: scale(1) translate3d(-1%, -0.5%, 0);
      }
      100% {
        transform: scale(1.08) translate3d(1%, 0.5%, 0);
      }
    }

    .animate-ken-burns {
      animation: kenBurnsSlow 22s ease-in-out infinite;
      will-change: transform;
    }

    .animate-ken-burns-alt {
      animation: kenBurnsAlt 18s ease-in-out infinite;
      will-change: transform;
    }

    /* Бесконечная плавная лента движущихся картин */
    @keyframes marqueeScroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }

    .marquee-track {
      display: flex;
      width: max-content;
      animation: marqueeScroll 45s linear infinite;
    }

    .marquee-wrapper:hover .marquee-track {
      animation-play-state: paused;
    }

    /* Плавное парение частиц/бликов */
    @keyframes floatParticle {
      0%, 100% {
        transform: translateY(0px) translateX(0px);
        opacity: 0.35;
      }
      50% {
        transform: translateY(-22px) translateX(10px);
        opacity: 0.85;
      }
    }

    .ember-dot {
      animation: floatParticle 6s ease-in-out infinite;
    }

    /* Плавное появление элементов при скролле */
    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .reveal-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Скрытие полосы прокрутки для навигации категорий */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Стиль резного логотипа KEMEGE как на обложке */
    .carved-logo {
      letter-spacing: 0.14em;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    }
  </style>
</head>
